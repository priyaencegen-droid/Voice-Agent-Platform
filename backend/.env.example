# Required: generate a long random value and keep it private.
JWT_SECRET_KEY=

# Provider credentials for the voice pipeline.
GROQ_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Optional database URL. Defaults to SQLite in the backend working directory.
DATABASE_URL=sqlite:///./voiceforge.db

# Optional JWT settings.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Optional: required to enable Twilio inbound and outbound calling.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=
